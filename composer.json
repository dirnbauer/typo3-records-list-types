{
    "name": "webconsulting/records-list-types",
    "type": "typo3-cms-extension",
    "description": "Grid, compact and teaser views for the TYPO3 v14 Records module, built from Core's own record controls, plus custom Fluid views and record filters.",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Webconsulting",
            "email": "office@webconsulting.at",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/dirnbauer/typo3-records-list-types",
    "support": {
        "issues": "https://github.com/dirnbauer/typo3-records-list-types/issues",
        "source": "https://github.com/dirnbauer/typo3-records-list-types"
    },
    "require": {
        "php": "^8.4",
        "typo3/cms-backend": "^14.3.7",
        "typo3/cms-core": "^14.3.7",
        "typo3/cms-fluid": "^14.3.7"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpat/phpat": "^0.12.5",
        "phpstan/phpstan": "^2.2.14",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpunit/phpunit": "^13.3.4",
        "saschaegerer/phpstan-typo3": "^3.1",
        "ssch/typo3-rector": "^3.16",
        "typo3/coding-standards": "^0.9",
        "typo3/testing-framework": "^9.7"
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\RecordsListTypes\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webconsulting\\RecordsListTypes\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "records_list_types",
            "version": "1.3.0",
            "web-dir": "public"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "scripts": {
        "ci": "Build/Scripts/runTests.sh -s ci",
        "ci:cgl": "Build/Scripts/runTests.sh -s cgl",
        "ci:cgl:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "ci:functional": "Build/Scripts/runTests.sh -s functional",
        "ci:lint": "Build/Scripts/runTests.sh -s lint",
        "ci:phpstan": "Build/Scripts/runTests.sh -s phpstan",
        "ci:unit": "Build/Scripts/runTests.sh -s unit"
    }
}
